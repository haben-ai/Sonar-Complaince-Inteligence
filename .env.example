# Optional. Without a key the system runs in deterministic fallback mode (no LLM calls).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Path of the default demo drawing (downloaded by scripts/fetch_dana_v.sh)
DEFAULT_DESIGN_PDF=data/input/dana_general_arrangement.pdf
# Fallbacks tried when the primary model is overloaded (503/504); per-call timeout in seconds
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite
GEMINI_TIMEOUT_S=20
# Set to true to put the whole app (UI + API) behind HTTP Basic auth. Off by default.
BASIC_AUTH_ENABLED=false
BASIC_AUTH_USER=admin
BASIC_AUTH_PASSWORD=sonar-demo
